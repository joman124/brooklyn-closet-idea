run = "npm install && npm run dev -- -p 3000"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm run start"]

[agent]
expertMode = true
